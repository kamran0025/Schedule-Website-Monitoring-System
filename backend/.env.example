NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://localhost:27017/newsletter-extension
MAX_ACTIVE_SCHEDULES_PER_INSTANCE=20
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
SCHEDULER_POLL_INTERVAL_MS=30000
REDIS_URL=redis://localhost:6379
EXECUTION_JOB_MAX_ATTEMPTS=3
EXECUTION_JOB_BACKOFF_DELAY_MS=5000
EXECUTION_WORKER_CONCURRENCY=5
RENDER_NAVIGATION_TIMEOUT_MS=30000
RENDER_MAX_RESPONSE_BYTES=26214400
RENDER_MAX_CONCURRENT_PAGES=3
RENDER_USER_AGENT=NewsletterExtensionBot/1.0 (+render worker)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
HISTORY_RETENTION_DAYS=30
HISTORY_CLEANUP_INTERVAL_MS=86400000
LISTING_MAX_ITEMS_PER_DIGEST=5
LOG_LEVEL=info
RENDER_BROWSER_POOL_SIZE=2
SNAPSHOT_DEDUPE_TTL_MS=120000
